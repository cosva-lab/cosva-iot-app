# Mosquitto ACL (Access Control List) for Cosva IoT

# Admin user has full access
user admin
topic readwrite #

# Firmware devices (ESP32) publish scale + RFID under cosva/
user cosva
topic write cosva/#
topic read cosva/#

# Sensor service: firmware topics, milking engine, legacy RFID JSON
user sensor_service
topic readwrite cosva/#
topic readwrite milking/#
topic write sensors/rfid/+/detections
topic write sensors/rfid/+/presence
topic read sensors/rfid/+/detections
topic read sensors/rfid/+/presence

# Sync service
user sync_service
topic read sensors/rfid/+/detections
topic read sensors/rfid/+/presence
topic read milking/#
topic write cosva/service/sync/version

# Dashboard service
user dashboard_service
topic read sensors/rfid/+/detections
topic read sensors/rfid/+/presence
topic readwrite milking/#
topic read cosva/#

# Compose default service user
user cosva_service
topic readwrite #

# Anonymous users (if enabled) have no access
user anonymous
topic read #
