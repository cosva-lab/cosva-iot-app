{
  "name": "@cosva-lab/iot-app",
  "version": "1.0.0",
  "description": "Smart milking farm IoT system with microservices architecture",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "start": "turbo run start --parallel --filter=@cosva-lab/sensor-service --filter=@cosva-lab/sync-service --filter=@cosva-lab/dashboard-service",
    "update": "turbo run update",
    "predocker:up": "npm run vendor:packages && npm run build:shared",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed/index.js",
    "vendor:packages": "./scripts/docker/vendor-packages.sh",
    "build:shared": "./scripts/docker/build-shared-base.sh",
    "docker:clean": "./scripts/clean-docker.sh",
    "clean": "rm -rf node_modules && rm -rf */node_modules && rm -rf */*/node_modules",
    "install:all": "npm install && npm install --workspaces",
    "dev:watch": "./scripts/dev/watch.sh",
    "dev:reload:dashboard": "./scripts/dev/reload-dashboard.sh",
    "dev:reload:services": "./scripts/dev/reload-services.sh",
    "dev:reset-db": "./scripts/dev/reset-db.sh",
    "dev:up": "docker compose up -d",
    "dev:logs": "docker compose logs -f dashboard-service sensor-service sync-service",
    "dev:ps": "docker compose ps",
    "sim": "npm --prefix cli run start --"
  },
  "dependencies": {
    "@cosva-lab/iot-db": "^1.2.1",
    "@cosva-lab/iot-shared": "^1.2.1",
    "@prisma/client": "^6.16.2",
    "prisma": "^6.16.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.9.2"
}
